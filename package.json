{
  "name": "easytax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "start": "next start -p 3004",
    "typecheck": "tsc --noEmit",
    "test": "EASYTAX_STUB_NEXT_CACHE=1 node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DeprecationWarning --import tsx --import ./scripts/register-payload-loader.mjs --test --test-force-exit \"tests/**/*.test.ts\"",
    "cms": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DeprecationWarning --import ./scripts/register-payload-loader.mjs node_modules/payload/bin.js",
    "cms:types": "npm run cms -- generate:types --disable-transpile",
    "cms:importmap": "npm run cms -- generate:importmap --disable-transpile",
    "cms:migrate": "npm run cms -- migrate --disable-transpile",
    "cms:migrate:create": "npm run cms -- migrate:create --disable-transpile",
    "admin:create": "node --env-file-if-exists=.env --import ./scripts/register-payload-loader.mjs ./scripts/create-admin.mjs",
    "content:import-demo": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DeprecationWarning --import ./scripts/register-payload-loader.mjs ./scripts/import-demo-content.ts",
    "cms:seed": "npm run cms -- run src/seed/index.ts --disable-transpile",
    "cms:audit": "npm run cms -- run src/scripts/audit-layout.ts --disable-transpile"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@puckeditor/core": "^0.23.0",
    "graphql": "^16.14.2",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.64.1",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "sass": "1.106.1"
  }
}
