# Salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env

# Koneksi PostgreSQL. Untuk produksi gunakan kredensial terkelola (bukan
# hardcode), mis. postgresql://user:password@host:5432/easytax?sslmode=require
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/easytax

# Kunci rahasia Payload. Wajib unik & acak (>= 32 karakter).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME

# Set 'true' bila Next.js dijalankan dengan cacheComponents: true (default proyek ini).
PAYLOAD_CACHE_COMPONENTS_ENABLED=true

# URL publik server (dipakai admin/API Payload). Opsional, fallback ke
# http://localhost:3004 saat pengembangan.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3004

# Akun admin awal untuk seed (opsional). Default: admin@easytax.id / EasyTax#2026
SEED_ADMIN_EMAIL=admin@easytax.id
SEED_ADMIN_PASSWORD=EasyTax#2026
