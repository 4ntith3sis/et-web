# ==============================================================================
# EASYTAX — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. DATABASE (POSTGRESQL)
# ------------------------------------------------------------------------------
# Format URL: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Untuk lokal tanpa Docker: postgresql://postgres:postgres@localhost:5432/easytax
# Isi URL sesuai database lokal/Compose; kredensial di bawah hanya contoh placeholder.
DATABASE_URI=postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>
# DATABASE_URL disediakan sebagai alias kompatibilitas standar Prisma / Drizzle
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>

# Variabel konfigurasi untuk kontainer PostgreSQL pada Docker Compose (opsional):
POSTGRES_DB=easytax
POSTGRES_USER=easytax
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. PAYLOAD CMS
# ------------------------------------------------------------------------------
# Kunci rahasia Payload. Wajib acak, unik & minimal 32 karakter.
# Generate cepat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME_TO_A_UNIQUE_RANDOM_SECRET_MINIMUM_32_CHARS

# Server URL publik untuk Payload Admin & Next.js Image Optimization
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3004

# Konfigurasi Cache Components Next.js 16 (default: true)
PAYLOAD_CACHE_COMPONENTS_ENABLED=true

# ------------------------------------------------------------------------------
# 3. WEBSITE & SEO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# ------------------------------------------------------------------------------
# 4. SEED & INITIAL SETUP (Opsional)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@easytax.id
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_RANDOM_PASSWORD

# ------------------------------------------------------------------------------
# 5. SEMANTIC SEARCH ARTIKEL (Opsional)
# ------------------------------------------------------------------------------
# Model lokal diunduh saat persiapan cache. Saat runtime unduhan dinonaktifkan,
# sehingga siapkan cache dahulu; true hanya untuk bootstrap dengan internet.
RAG_EMBEDDING_MODEL=Horizon-Labs/multilingual-embedding-small
RAG_EMBEDDING_CACHE_DIR=/app/model-cache
RAG_EMBEDDING_ALLOW_DOWNLOAD=false

# Default false. Aktifkan setelah migration embedding diterapkan dan artikel
# sudah di-reindex pada environment tersebut. Model file tidak termasuk
# image/cache Git; mount cache model ke RAG_EMBEDDING_CACHE_DIR.
RAG_ARTIKEL_ENABLED=false

# Dimensi model: 1024. Jangan gunakan index lama berdimensi 1536.

# Ukuran chunk dan overlap dalam karakter
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150

# Jumlah chunk teratas yang diambil saat retrieval
# RAG_RETRIEVAL_LIMIT=6

# Threshold cosine similarity minimum (0–1). Default 0.48, dikalibrasi untuk
# skor model lokal multilingual-embedding-small.
# RAG_SIMILARITY_THRESHOLD=0.48

# Panjang maksimal query pengguna (karakter)
# RAG_MAX_QUERY_LENGTH=500
